# --- Django ---
SECRET_KEY=change-me-no-default-is-provided-on-purpose
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Dev: leave unset to use SQLite. Prod: full Postgres URL.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Radio ---
RADIO_STATION_ID=s97f38db97
RADIO_STREAM_URL=https://s3.radio.co/s97f38db97/listen
RADIO_STATUS_URL=https://public.radio.co/stations/s97f38db97/status

# --- Email (salvation notifications) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SALVATION_TEAM_EMAIL=
# Where contact-page alerts go. Empty: messages wait in the admin, no alert.
CONTACT_TEAM_EMAIL=

# --- Studio (the site's editor, at /studio) ---
# How long an editor stays signed in, in days.
STUDIO_SESSION_DAYS=7
# Uploaded photos live under backend/media/. Django serves them in DEBUG; in
# production set this to True to let Django serve them too, or leave it False
# and serve /media/ from the web server or a storage bucket. See STUDIO.md.
SERVE_MEDIA=False

# --- Frontend (set in the Next.js environment, not read by Django) ---
# Where the site's server reaches Django. Photos are proxied from its /media/.
# API_URL=http://127.0.0.1:8000/api/v1
